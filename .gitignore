*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
MANIFEST

# Local configuration and secrets
.env
.env.*
!.env.example
*.local
*.secret
*.secrets
*.pem
*.key

# Generated study workspaces and private source material.
# Keep public fixtures under examples/ or tests/ explicitly tracked.
/data/
/inputs/
/outputs/
/artifacts/
/workspace/
/private-data/
/local-data/
/recordings/
/transcripts/
/screenshots/
*.pptx
*.ppt
*.pdf
*.docx
*.xlsx
*.xls
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.srt
*.vtt

# A fixture may opt back in only when it is synthetic or redistribution-cleared.
!examples/**/*.pptx
!examples/**/*.ppt
!examples/**/*.pdf
!examples/**/*.docx
!examples/**/*.wav
!examples/**/*.mp3
!examples/**/*.srt
!examples/**/*.vtt
!tests/fixtures/**/*.pptx
!tests/fixtures/**/*.pdf
!tests/fixtures/**/*.docx
!tests/fixtures/**/*.srt
!tests/fixtures/**/*.vtt

# JavaScript/Web tooling
node_modules/
web/dist/
web/.vite/
web/.next/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

